#!/bin/sh
# ============================================================
# Git pre-commit hook: 检测 Flyway 迁移文件的修改
# 防止意外修改已应用的迁移导致 checksum 不匹配
# ============================================================

MIGRATION_DIR="backend/platform-server/src/main/resources/db/migration"

# 获取暂存区中修改的迁移文件
MODIFIED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=M -- "$MIGRATION_DIR")

if [ -n "$MODIFIED_MIGRATIONS" ]; then
    echo ""
    echo "============================================================"
    echo "  [WARNING] 检测到已存在的 Flyway 迁移文件被修改！"
    echo "============================================================"
    echo ""
    echo "  以下迁移文件被修改："
    echo "$MODIFIED_MIGRATIONS" | while read -r file; do
        echo "    - $file"
    done
    echo ""
    echo "  修改已应用的迁移文件会导致 checksum 不匹配，"
    echo "  使其他开发者的本地数据库无法启动。"
    echo ""
    echo "  推荐做法：创建新的迁移文件来实现变更。"
    echo "  详见：.qoder/rules/flyway-migration.md"
    echo ""
    echo "  如果确认这些文件尚未 push 到远程仓库，"
    echo "  可以使用 --no-verify 跳过此检查："
    echo "    git commit --no-verify -m \"your message\""
    echo ""

    # 检查这些文件是否已经存在于远程分支
    HAS_REMOTE_CHANGES=false
    echo "$MODIFIED_MIGRATIONS" | while read -r file; do
        if git ls-remote --exit-code origin HEAD -- "$file" >/dev/null 2>&1; then
            # 文件存在于远程，尝试比较
            REMOTE_BRANCH=$(git rev-parse --abbrev-ref @{upstream} 2>/dev/null)
            if [ -n "$REMOTE_BRANCH" ]; then
                if git show "$REMOTE_BRANCH:$file" >/dev/null 2>&1; then
                    echo "  [!] $file 已存在于远程分支 $REMOTE_BRANCH"
                    HAS_REMOTE_CHANGES=true
                fi
            fi
        fi
    done

    echo ""
    read -p "  是否仍然要继续提交？(y/N) " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "  提交已取消。"
        exit 1
    fi
    echo "  继续提交（请确保已了解风险）。"
    echo ""
fi

# 检测新增的迁移文件（仅提示，不阻断）
NEW_MIGRATIONS=$(git diff --cached --name-only --diff-filter=A -- "$MIGRATION_DIR")
if [ -n "$NEW_MIGRATIONS" ]; then
    echo ""
    echo "  [INFO] 新增迁移文件："
    echo "$NEW_MIGRATIONS" | while read -r file; do
        echo "    + $file"
    done
    echo ""
fi

exit 0
