<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 日志文件存储路径：由 Maven 资源过滤注入 platform-server 模块的绝对路径，
         运行时自动解析为 D:\...\backend\platform-server\..\log → backend\log\ -->
    <property name="LOG_PATH" value="@project.basedir@/../log"/>
    <!-- 日志文件格式（不含颜色，适用于文件输出） -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ======================== 控制台输出 ======================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan([%thread]) %boldMagenta(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== 全量运行日志 all.log（按日期+大小滚动） ======================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/all.log</file>
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 每天生成新文件，单文件最大 100MB -->
            <fileNamePattern>${LOG_PATH}/all.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <!-- 启动时清理旧归档文件，不保留历史日志 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== 错误日志 err.log（仅 ERROR 级别） ======================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/err.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/err.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ======================== 接口访问日志 access.log ========================
         由独立 logger「com.platform.access」输出（additivity=false，不进 all.log）。
         记录内容：请求方法、地址、查询参数、来源IP、状态码、耗时、请求体/响应体（敏感字段脱敏）。
    -->
    <appender name="ACCESS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/access.log</file>
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/access.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 接口访问日志独立 logger：仅写入 access.log，不向上传播至 root（不进 all.log） -->
    <logger name="com.platform.access" level="INFO" additivity="false">
        <appender-ref ref="ACCESS"/>
    </logger>

    <!-- ======================== Swagger 同步/导入日志 swagger.log ========================
         由独立 logger「com.platform.apidoc.swagger」输出（additivity=false，不进 all.log）。
         用于集中查看 Swagger 同步、导入、候选 URL 探测等日志。
    -->
    <appender name="SWAGGER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/swagger.log</file>
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/swagger.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Swagger 同步/导入日志独立 logger：仅写入 swagger.log，不向上传播至 root -->
    <logger name="com.platform.apidoc.swagger" level="DEBUG" additivity="false">
        <appender-ref ref="SWAGGER"/>
    </logger>

    <!-- ======================== 屏蔽数据库调用详情日志 ========================
         将 MyBatis mapper 命名空间及数据库基础设施组件的日志级别提升至 WARN，
         阻止 DEBUG 级别的 SQL 语句、参数绑定、结果集等信息写入 all.log。
    -->
    <logger name="com.platform.action.mapper" level="WARN"/>
    <logger name="com.platform.apidoc.mapper" level="WARN"/>
    <logger name="com.platform.auth.mapper" level="WARN"/>
    <logger name="com.platform.environment.mapper" level="WARN"/>
    <logger name="com.platform.execution.mapper" level="WARN"/>
    <logger name="com.platform.keyword.mapper" level="WARN"/>
    <logger name="com.platform.project.mapper" level="WARN"/>
    <logger name="com.platform.sys.mapper" level="WARN"/>
    <logger name="com.platform.tool.mapper" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache.ibatis" level="WARN"/>
    <logger name="org.mybatis.spring" level="WARN"/>

    <!-- ======================== 开发环境：控制台 + 文件 ======================== -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.platform" level="DEBUG"/>
        <logger name="org.springframework.web" level="INFO"/>
    </springProfile>

    <!-- ======================== 生产环境：仅文件（无控制台） ======================== -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.platform" level="INFO"/>
    </springProfile>

</configuration>
